# Network
INFURA_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Wallet
PRIVATE_KEY=your_private_key
MEV_CONTRACT_ADDRESS=0x...

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=mev_bot
DB_PORT=5432

# Strategy Parameters
MIN_PROFIT_USD=50
MAX_GAS_PRICE_GWEI=300
MIN_TRANSACTION_VALUE_USD=10000
SANDWICH_MAX_SLIPPAGE=0.05
ARBITRAGE_MIN_PROFIT_BPS=30
LIQUIDATION_MIN_BONUS_BPS=500

# Flash Loan
AAVE_POOL_ADDRESS=0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
MAX_FLASH_LOAN_ETH=1000

# Monitoring
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id
ENABLE_DISCORD_ALERTS=false

# Risk Management
MAX_POSITION_SIZE_ETH=10
EMERGENCY_STOP=false
DRY_RUN_MODE=true
