# .env.example
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secret values.
# For production, set these variables in the Netlify dashboard under
# Site Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Netlify deployment context
# Automatically set by Netlify to one of: production, deploy-preview,
# branch-deploy, or dev. For local development you may set this manually.
# ---------------------------------------------------------------------------
# CONTEXT=dev

# ---------------------------------------------------------------------------
# Netlify CLI dev mode indicator
# Automatically set to "true" by `netlify dev`. You do not need to set this.
# ---------------------------------------------------------------------------
# NETLIFY_DEV=true

# ---------------------------------------------------------------------------
# Trade Executor API
# The base URL of the external trade-executor service.
# Example value for the hosted Replit instance:
#   TRADE_EXECUTOR_URL=https://vault-bot--diodatomatt9.replit.app
# ---------------------------------------------------------------------------
# TRADE_EXECUTOR_URL=

# ---------------------------------------------------------------------------
# Disable blob uploads (optional)
# Set to "true" to hide the blob upload feature in the UI.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DISABLE_UPLOADS=true
