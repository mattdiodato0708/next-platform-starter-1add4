# .env.example

# Private Key
PRIVATE_KEY=your_private_key_here

# RPC Endpoints
RPC_ENDPOINT=https://your_rpc_endpoint_here

# Database URL
DATABASE_URL=postgres://username:password@localhost:5432/your_database_name

# Bot Configuration
BOT_CONFIG={
  "option1": "value1",
  "option2": "value2",
  "option3": "value3"
}